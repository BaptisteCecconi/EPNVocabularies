###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/AACGM
:AACGM rdf:type owl:NamedIndividual ,
                :EarthCenteredFrame ;
       rdfs:label "Altitude-Adjusted Corrected Geomagnetic Coordinates" ;
       prov:wasDerivedFrom <https://doi.org/10.1007/s11214-016-0275-y> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/CD
:CD rdf:type owl:NamedIndividual ,
             :EarthCenteredFrame ;
    rdfs:label "Centered Dipole" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s11214-016-0275-y> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/CGM
:CGM rdf:type owl:NamedIndividual ,
              :EarthCenteredFrame ;
     rdfs:label "Corrected Geomagnetic Coordinates" ;
     prov:wasDerivedFrom <https://doi.org/10.1007/s11214-016-0275-y> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/CPHIO
:CPHIO rdf:type owl:NamedIndividual ,
                :CallistoCenteredFrame ,
                :PhiOmegaFrame ;
       rdfs:comment """In this Cartesian coordinate system, X is along the flow direction, Y is along the Callisto-Jupiter vector, and Z is along the spin axis.
These coordinates are analogous to the earth-centered GSE coordinates that relate to the direction of flow of the solar wind onto Earth's environment.""" ;
       rdfs:label "Callisto Phi-Omega" ;
       rdfs:seeAlso :GSE ;
       prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/DIIS
:DIIS rdf:type owl:NamedIndividual ,
               :DioneCenteredFrame ;
      rdfs:comment """The Dione Inter-action coordinate System frame is defined as follows:
  -  The inertially referenced velocity of Saturn relative to Dione is the primary vector: +X;
  -  The position of Saturn relative to Dione is the secondary vector: +Y axis points from Dione to Saturn;
  -  +Z axis completes the right-handed system;
  -  the origin of this frame is Dione's center of mass.""" ;
      rdfs:label "Dione Inter-action coordinate System" ;
      prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/DME
:DME rdf:type owl:NamedIndividual ,
              :DeimosCenteredFrame ,
              :MeanEquatorEquinoxDate ;
     rdfs:comment """The Deimos Mean Equator of Date frame (also known as Deimos Mean Equator and IAU vector of
      Date frame) is defined as follows :
    -  X-Y plane is defined by the Deimos equator of date, and the +Z axis, primary vector of this frame, is parallel
       to the Moon's rotation axis of date, pointing toward the North side of the invariant plane;
    -  +X axis is defined by the intersection of the Moon's equator of date with the Earth Mean Equator of J2000;
    -  +Y axis completes the right-handed system;
    -  the origin of this frame is Deimos' center of mass.""" ;
     rdfs:label "Deimos Mean Equator" ;
     prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/DSE
:DSE rdf:type owl:NamedIndividual ,
              :DeimosCenteredFrame ,
              :SolarEclipticFrame ;
     rdfs:comment """The Deimos-centric Solar Ecliptic frame is defined as follows:
  -  The position of the Sun relative to Deimos is the primary vector: +X axis points from Moon to the Sun;
  -  The inertially referenced velocity of the Sun relative to Deimos is the secondary vector: +Y axis is the component
     of this velocity vector orthogonal to the +X axis;
  -  +Z axis completes the right-handed system;
  -  the origin of this frame is Deimos' center of mass.""" ;
     rdfs:label "Deimos-centric Solar Ecliptic" ;
     prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/EPHIO
:EPHIO rdf:type owl:NamedIndividual ,
                :EuropaCenteredFrame ,
                :PhiOmegaFrame ;
       rdfs:comment """In this Cartesian coordinate system, X is along the flow direction, Y is along the Europa-Jupiter vector, and Z is along the spin axis.
These coordinates are analogous to the earth-centered GSE coordinates that relate to the direction of flow of the solar wind onto Earth's environment.""" ;
       rdfs:label "Europa Phi-Omega" ;
       rdfs:seeAlso :GSE ;
       prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GPHIO
:GPHIO rdf:type owl:NamedIndividual ,
                :GanymedeCenteredFrame ,
                :PhiOmegaFrame ;
       rdfs:comment """In this Cartesian coordinate system, X is along the flow direction, Y is along the Ganymede-Jupiter vector, and Z is along the spin axis.
These coordinates are analogous to the earth-centered GSE coordinates that relate to the direction of flow of the solar wind onto Earth's environment""" ;
       rdfs:label "Ganymede Phi-Omega" ;
       rdfs:seeAlso :GSE ;
       prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GRIGGSKELL_CSO
:GRIGGSKELL_CSO rdf:type owl:NamedIndividual ,
                         :Comet26PCenteredFrame ,
                         :SolarOrbitalFrame ;
                rdfs:comment """GRIGG-SKJELLERUP Solar Orbital frame is defined as a two-vector style dynamic frames as
      follows:
  -  The position of the sun relative to the comet is the primary vector: the X axis points from the comet to the sun.
  -  The inertially referenced velocity of the sun relative to the comet is the secondary vector: the Y axis is the
     component of this velocity vector orthogonal to the X axis.
  -  The Z axis is X cross Y, completing the right-handed reference frame.""" ;
                rdfs:label "Comet solar orbital centered on GRIGG-SKJELLERUP comet" ;
                prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GRIGGSKELL_EME
:GRIGGSKELL_EME rdf:type owl:NamedIndividual ,
                         :Comet26PCenteredFrame ,
                         :MeanEquatorEquinoxDate ;
                rdfs:comment """Same as #EME (Earth mean equator, dynamical equinox of J2000) but centered on
      Comet 26P/Grigg-Skjellerup.""" ;
                rdfs:label "J2000 centered on Comet 26P/Grigg-Skjellerup" ;
                prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GSE
:GSE rdf:type owl:NamedIndividual ,
              :EarthCenteredFrame ,
              :SolarEclipticFrame ;
     rdfs:comment """The Earth-centric Solar Ecliptic frame is defined as follows :
      -  X-Y plane is defined by the Earth Mean Ecliptic plane of date: the +Z axis, primary vector, is the normal
         vector to this plane, always pointing toward the North side of the invariant plane;
      -  +X axis is the component of the Earth-Sun vector that is orthogonal to the +Z axis;
      -  +Y axis completes the right-handed system;
      -  the origin of this frame is the Sun's center of mass.""" ;
     rdfs:label "Geocentric Solar Ecliptic" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GSEQ
:GSEQ rdf:type owl:NamedIndividual ,
               :EarthCenteredFrame ;
      rdfs:comment """The Geocentric Solar Equatorial frame is defined as follows :
  - +X axis is the position of the Sun relative to the Earth; it's the primary vector and points from the Earth to the Sun;
  - +Z axis is the component of the Sun's north pole of date orthogonal to the +X axis;
  - +Y axis completes the right-handed reference frame;
  - the origin of this frame is the Earth's center of mass.""" ;
      rdfs:label "Geocentric Solar Equatorial" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/GSM
:GSM rdf:type owl:NamedIndividual ,
              :EarthCenteredFrame ;
     rdfs:comment """A coordinate system where the X axis is from Earth to Sun, Z axis is northward in a plane
      containing the X axis and the geomagnetic dipole axis. See Russell, 1971

  Thus, +X is identical to `#GSE` +X and is the primary, and +Z is the secondary and is the MAG +Z.""" ;
     rdfs:label "Geocentric Solar Magnetospheric" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/HALLEY_CSO
:HALLEY_CSO rdf:type owl:NamedIndividual ,
                     :Comet1PCenteredFrame ,
                     :SolarOrbitalFrame ;
            rdfs:comment """Halley comeet solar orbital frame is defined as a two-vector style dynamic frames as follows:
  -  The position of the sun relative to the comet is the primary vector: the X axis points from the comet to the sun.
  -  The inertially referenced velocity of the sun relative to the comet is the secondary vector: the Y axis is the
     component of this velocity vector orthogonal to the X axis.
  -  The Z axis is X cross Y, completing the right-handed reference frame.""" ;
            rdfs:label "Comet solar orbital centered on HALLEY comet" ;
            prov:wasDerivedFrom <https://treps.irap.omp.eu> .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/HALLEY_EME
:HALLEY_EME rdf:type owl:NamedIndividual ,
                     :Comet1PCenteredFrame ,
                     :EME ;
            rdfs:comment """Same as #EME (Earth mean equator, dynamical equinox of J2000) but centered on Halley
      comet.""" ;
            rdfs:label "J2000 centered on HALLEY comet" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/HCI
:HCI rdf:type owl:NamedIndividual ,
              :SunCenteredFrame ;
     rdfs:comment """The Heliocentric Inertial Frame is defined as follows :
  - X-Y plane is defined by the Sun's equator of epoch J2000: the +Z axis, primary vector, is parallel to the Sun's
    rotation axis of epoch J2000, pointing toward the Sun's north pole;
  - +X axis is defined by the ascending node of the Sun's equatorial plane on the ecliptic plane of J2000;
  - +Y completes the right-handed frame;
  - the origin of this frame is the Sun's center of mass.""" ;
     rdfs:label "Heliocentric Inertial" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/HEE
:HEE rdf:type owl:NamedIndividual ,
              :SunCenteredFrame ;
     rdfs:comment """The Heliocentric Earth Ecliptic frame is defined as follows :
  -  X-Y plane is defined by the Earth Mean Ecliptic plane of date, therefore, the +Z axis is the primary vector, and
     it is defined as the normal vector to the Ecliptic plane that points toward the north pole of date;
  -  +X axis is the component of the Sun-Earth vector that is orthogonal to the +Z axis;
  -  +Y axis completes the right-handed system;
  -  the origin of this frame is the Sun's center of mass.""" ;
     rdfs:label "Heliocentric Earth Ecliptic" .


###  http://voparis-ns.obspm.fr/rdf/ihdea/refframe/HEEQ
:HEEQ rdf:type owl:NamedIndividual ,
               :SunCenteredFrame ;
      rdfs:comment """The Heliocentric Earth Equatorial frame is defined as follows:
  - X-Y plane is the solar equator of date, therefore, the +Z axis is the primary vector and it is aligned to the Sun's
    north pole of date;
  - +X axis is defined by the intersection between the Sun equatorial plane and the solar central meridian of date as
    seen from the Earth. The solar central meridian of date is defined as the meridian of the Sun that is turned toward
    the Earth. Therefore, +X axis is the component of the Sun-Earth vector that is orthogonal to the +Z axis;
  - +Y axis completes the right-handed system;
  - the origin of this frame is the Sun's center of mass.""" ;
      rdfs:label "Heliocentric Earth Equatorial" .


